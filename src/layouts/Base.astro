---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Fidalgo Studio — Contenido, foto, video y estrategia',
  description = 'Estudio creativo de Tomás Fidalgo enfocado en contenido, producción audiovisual y comunicación visual para marcas, proyectos y emprendimientos.',
} = Astro.props;
const ogImage = new URL('/og.jpg', Astro.site ?? Astro.url).href;
---

<!doctype html>
<html lang="es-AR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0d0d0d" />
    <script is:inline>document.documentElement.classList.add('js');</script>
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preload" href="/fonts/PPNeueMachina-Ultrabold.otf" as="font" type="font/otf" crossorigin />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_AR" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    <slot />

    <!-- Desenfoque progresivo en los bordes de la pantalla y grano fino global -->
    <div class="edge-blur edge-blur--top" aria-hidden="true"><span></span><span></span><span></span></div>
    <div class="edge-blur edge-blur--bottom" aria-hidden="true"><span></span><span></span><span></span></div>
    <div class="grain" aria-hidden="true"></div>

    <script>
      import Lenis from 'lenis';

      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      // Scroll suave (se desactiva si el usuario pidió menos movimiento)
      if (!reduceMotion) {
        const lenis = new Lenis({ anchors: { offset: -72 } });
        const raf = (time: number) => {
          lenis.raf(time);
          requestAnimationFrame(raf);
        };
        requestAnimationFrame(raf);
        document.addEventListener('lenis:stop', () => lenis.stop());
        document.addEventListener('lenis:start', () => lenis.start());
      }

      // Estado del scroll para los desenfoques de borde: activos solo entre el hero y el final
      const root = document.documentElement;
      const onScroll = () => {
        const y = window.scrollY;
        root.classList.toggle('is-scrolled', y > window.innerHeight * 0.6);
        root.classList.toggle('at-end', y + window.innerHeight > document.body.scrollHeight - 120);
      };
      window.addEventListener('scroll', onScroll, { passive: true });
      onScroll();

      // Aparición de elementos al entrar en pantalla
      const io = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-in');
              io.unobserve(entry.target);
            }
          }
        },
        { rootMargin: '0px 0px -10% 0px' },
      );
      document.querySelectorAll('.reveal, [data-reveal]').forEach((el) => io.observe(el));
    </script>
  </body>
</html>

---
import '../styles/global.css';
import JsonLd from '../components/JsonLd.astro';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Fidalgo Studio | Fotografía, video y contenido en Tucumán',
  description = 'Estudio creativo de Tomás Fidalgo en Tucumán: creación de contenido, fotografía, video, edición y estrategia para marcas, proyectos y emprendimientos.',
} = Astro.props;
const site = Astro.site ?? new URL(Astro.url.origin);
const canonical = new URL(Astro.url.pathname, site).href;
const ogImage = new URL('/og-fidalgo-studio.jpg', site).href;
const ogAlt = 'Fidalgo Studio, estudio creativo de contenido, foto y video';
---

<!doctype html>
<html lang="es-AR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <meta name="author" content="Tomás Fidalgo" />
    <meta name="geo.region" content="AR-T" />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#0d0d0d" />
    <meta name="color-scheme" content="dark" />
    <script is:inline>document.documentElement.classList.add('js');</script>
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="icon" type="image/png" sizes="64x64" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preload" href="/media/showreel.webp" as="image" type="image/webp" fetchpriority="high" />
    <link rel="preload" href="/fonts/PPNeueMachina-Ultrabold.woff2" as="font" type="font/woff2" crossorigin />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Fidalgo Studio" />
    <meta property="og:locale" content="es_AR" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:secure_url" content={ogImage} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogAlt} />
    <JsonLd />
  </head>
  <body>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    <slot />

    <!-- Desenfoque progresivo en los bordes de la pantalla y grano fino global -->
    <div class="edge-blur edge-blur--top" aria-hidden="true"><span></span><span></span><span></span></div>
    <div class="edge-blur edge-blur--bottom" aria-hidden="true"><span></span><span></span><span></span></div>
    <div class="grain" aria-hidden="true"></div>

    <script>
      import Lenis from 'lenis';

      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      // Scroll suave (se desactiva si el usuario pidió menos movimiento)
      if (!reduceMotion) {
        const lenis = new Lenis({ anchors: { offset: -72 } });
        const raf = (time: number) => {
          lenis.raf(time);
          requestAnimationFrame(raf);
        };
        requestAnimationFrame(raf);
        document.addEventListener('lenis:stop', () => lenis.stop());
        document.addEventListener('lenis:start', () => lenis.start());
      }

      // Estado del scroll para los desenfoques de borde: activos solo entre el hero y el final
      const root = document.documentElement;
      const onScroll = () => {
        const y = window.scrollY;
        root.classList.toggle('is-scrolled', y > window.innerHeight * 0.6);
        root.classList.toggle('at-end', y + window.innerHeight > document.body.scrollHeight - 120);
      };
      window.addEventListener('scroll', onScroll, { passive: true });
      onScroll();

      // Si se va a otra pestaña, el título la llama de vuelta
      const pageTitle = document.title;
      document.addEventListener('visibilitychange', () => {
        document.title = document.hidden ? 'Fidalgo Studio - Volvé!' : pageTitle;
      });

      document.querySelectorAll<HTMLImageElement>('img[loading="lazy"]').forEach((img) => {
        if (img.complete) return;
        img.classList.add('is-loading');
        const done = () => img.classList.remove('is-loading');
        img.addEventListener('load', done, { once: true });
        img.addEventListener('error', done, { once: true });
      });

      // Aparición de elementos al entrar en pantalla
      const io = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-in');
              io.unobserve(entry.target);
            }
          }
        },
        { rootMargin: '0px 0px -10% 0px' },
      );
      document.querySelectorAll('.reveal, [data-reveal]').forEach((el) => io.observe(el));
    </script>
  </body>
</html>

---
import { reels, contact } from '../data/site';
import Icon from './Icon.astro';
import SectionHead from './SectionHead.astro';
---

<section class="reels" id="reels">
  <div class="ambient" style="--gx: 15%; --gy: 55%" aria-hidden="true"></div>

  <div class="wrap">
    <SectionHead index="02" title="Reels" on="Idea, guion, rodaje y edición." off="Piezas pensadas para cada plataforma." />
    <div class="controls reveal">
      <span class="hint">Tocá un reel para verlo con sonido</span>
      <div class="arrows">
        <button class="arrow-btn" data-scroll="-1" aria-label="Reels anteriores"><Icon name="arrow-left" /></button>
        <button class="arrow-btn" data-scroll="1" aria-label="Reels siguientes"><Icon name="arrow-right" /></button>
      </div>
    </div>
  </div>

  <ul class="strip" data-strip data-lenis-prevent-wheel>
    {
      reels.map((r, i) => (
        <li class="reveal" style={`--d: ${Math.min(i, 4) * 0.07}s`}>
          <button class="phone-btn" data-reel={r.slug} aria-label={`Ver reel de ${r.client} con sonido`}>
            <!-- Mockup de celular -->
            <span class="phone">
              <span class="island" aria-hidden="true" />
              <video
                src={`/media/reels/${r.slug}-preview.mp4`}
                poster={`/media/reels/${r.slug}.webp`}
                muted
                loop
                playsinline
                preload="none"
                data-autoplay
              />
              <span class="play glass" aria-hidden="true">
                <Icon name="play" />
              </span>
            </span>
            <span class="info">
              <span class="num">({String(i + 1).padStart(2, '0')})</span>
              <span class="client">{r.client}</span>
              <span class="tag">{r.tag}</span>
            </span>
          </button>
        </li>
      ))
    }
    <li class="more-item">
      <a class="more glass" href={contact.instagramUrl} target="_blank" rel="noopener">
        <span class="em-off">Más trabajos en</span>
        <strong>{contact.instagram}</strong>
        <Icon name="arrow-up-right" class="more-arrow" />
      </a>
    </li>
  </ul>

  <dialog class="player" aria-label="Reproductor de reel">
    <form method="dialog">
      <button class="pill p-close">Cerrar <Icon name="close" /></button>
    </form>
    <span class="phone phone--big">
      <span class="island" aria-hidden="true"></span>
      <video controls playsinline></video>
    </span>
  </dialog>
</section>

<style>
  .reels {
    position: relative;
    isolation: isolate;
    padding-block: clamp(5rem, 10vw, 8rem);
  }
  .controls {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin: -1.5rem 0 2rem;
  }
  .hint {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.45);
  }
  .arrows {
    display: none;
    gap: 0.5rem;
  }
  .arrow-btn {
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border-radius: 50%;
    border: 1px solid rgba(255, 255, 255, 0.18);
    background: rgba(255, 255, 255, 0.05);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    transition:
      background-color 0.2s ease,
      color 0.2s ease,
      transform 0.16s var(--ease);
  }
  .arrow-btn:active {
    transform: var(--press);
  }
  @media (min-width: 900px) {
    .arrows {
      display: flex;
    }
  }
  @media (hover: hover) and (pointer: fine) {
    .arrow-btn:hover {
      background: var(--olive);
      border-color: var(--olive);
      color: var(--ink);
    }
  }

  /* Tira deslizable */
  .strip {
    display: flex;
    gap: clamp(1rem, 2vw, 1.75rem);
    margin: 0;
    padding: 1rem var(--gutter) 2rem;
    list-style: none;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: var(--gutter);
    scrollbar-width: none;
  }
  .strip::-webkit-scrollbar {
    display: none;
  }
  .strip > li {
    flex: 0 0 clamp(210px, 19vw, 270px);
    scroll-snap-align: start;
  }

  .phone-btn {
    display: grid;
    gap: 1rem;
    width: 100%;
    text-align: left;
  }

  /* Mockup: cuerpo negro con borde fino, isla y pantalla redondeada */
  .phone {
    position: relative;
    display: block;
    aspect-ratio: 9 / 19.5;
    padding: 7px;
    border-radius: 2.4rem;
    background: linear-gradient(150deg, #2a2a2a, #0f0f0f 45%, #1d1d1d);
    box-shadow:
      inset 0 0 0 1px rgba(255, 255, 255, 0.12),
      0 30px 60px -25px rgba(0, 0, 0, 0.9),
      0 0 40px -10px rgba(150, 153, 110, 0.15);
    transition: transform 0.6s var(--ease);
  }
  .phone video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 1.95rem;
    background: var(--ink-2);
  }
  .island {
    position: absolute;
    top: 14px;
    left: 50%;
    z-index: 2;
    width: 30%;
    height: 18px;
    border-radius: 999px;
    background: #000;
    transform: translateX(-50%);
  }
  .play {
    position: absolute;
    top: 50%;
    left: 50%;
    z-index: 2;
    display: grid;
    place-items: center;
    width: 3.6rem;
    height: 3.6rem;
    border-radius: 50%;
    font-size: 1.2rem;
    translate: -50% -50%;
    opacity: 0;
    scale: 0.85;
    transition:
      opacity 0.3s ease,
      scale 0.4s var(--ease);
  }

  .info {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.1rem 0.6rem;
    padding-inline: 0.3rem;
  }
  .num {
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--olive);
    font-variant-numeric: tabular-nums;
  }
  .client {
    font-family: var(--font-display);
    font-weight: 800;
    text-transform: uppercase;
    font-size: 1rem;
    line-height: 1.1;
  }
  .tag {
    grid-column: 2;
    font-size: 0.82rem;
    color: rgba(255, 255, 255, 0.5);
  }

  .phone-btn:active .phone {
    transform: scale(0.98);
  }
  @media (hover: hover) and (pointer: fine) {
    .phone-btn:hover .phone {
      transform: translateY(-8px) rotate(-1.5deg);
    }
    .phone-btn:hover .play {
      opacity: 1;
      scale: 1;
    }
  }

  /* Tarjeta final: más en Instagram */
  .more-item {
    display: flex;
  }
  .more {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: 0.3rem;
    width: 100%;
    aspect-ratio: 9 / 19.5;
    padding: 1.6rem;
    border-radius: 2.4rem;
    transition: background-color 0.3s ease;
  }
  .more strong {
    font-family: var(--font-display);
    font-size: 1.35rem;
    font-weight: 800;
  }
  .more :global(.more-arrow) {
    font-size: 1.8rem;
    margin-top: 0.6rem;
    color: var(--olive);
    transition: transform 0.4s var(--ease);
  }
  @media (hover: hover) and (pointer: fine) {
    .more:hover :global(.more-arrow) {
      transform: translate(4px, -4px);
    }
  }

  /* Reproductor con sonido */
  .player {
    padding: 0;
    border: 0;
    background: transparent;
    max-width: none;
    max-height: none;
    overflow: visible;
    color: var(--white);
  }
  .player[open] {
    display: grid;
    gap: 1rem;
    justify-items: center;
    animation: pop 0.4s var(--ease);
  }
  .player::backdrop {
    background: rgba(13, 13, 13, 0.75);
    backdrop-filter: blur(24px);
    -webkit-backdrop-filter: blur(24px);
  }
  .phone--big {
    height: min(80dvh, 150vw);
    width: auto;
  }
  @keyframes pop {
    from {
      opacity: 0;
      transform: translateY(16px) scale(0.98);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .player[open] {
      animation: none;
    }
    .phone,
    .play {
      transition: none;
    }
  }
</style>

<script>
  const strip = document.querySelector<HTMLUListElement>('[data-strip]')!;
  document.querySelectorAll<HTMLButtonElement>('[data-scroll]').forEach((b) =>
    b.addEventListener('click', () => {
      strip.scrollBy({ left: Number(b.dataset.scroll) * strip.clientWidth * 0.75, behavior: 'smooth' });
    }),
  );

  const player = document.querySelector<HTMLDialogElement>('.player')!;
  const video = player.querySelector('video')!;
  document.querySelectorAll<HTMLButtonElement>('[data-reel]').forEach((card) => {
    card.addEventListener('click', () => {
      video.src = `/media/reels/${card.dataset.reel}.mp4`;
      video.poster = `/media/reels/${card.dataset.reel}.webp`;
      player.showModal();
      document.dispatchEvent(new Event('lenis:stop'));
      video.play().catch(() => {});
    });
  });
  player.addEventListener('close', () => {
    video.pause();
    video.removeAttribute('src');
    video.load();
    document.dispatchEvent(new Event('lenis:start'));
  });
  // Click fuera del celular cierra
  player.addEventListener('click', (e) => e.target === player && player.close());
</script>

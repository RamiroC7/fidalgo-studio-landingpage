---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import { projects } from '../data/site';
import Icon from './Icon.astro';
import SectionHead from './SectionHead.astro';

// Fotos generadas por `npm run media` en src/assets/work/<slug>/NN.jpg
const files = import.meta.glob<{ default: ImageMetadata }>('/src/assets/work/*/*.jpg', { eager: true });
const photosOf = (slug: string) =>
  Object.entries(files)
    .filter(([path]) => path.includes(`/work/${slug}/`))
    .sort(([a], [b]) => a.localeCompare(b))
    .map(([, mod]) => mod.default);

const items = projects
  .map((p) => ({ ...p, photos: photosOf(p.slug) }))
  .filter((p) => p.photos.length)
  .map((p, i) => ({ ...p, num: String(i + 1).padStart(2, '0') }));

// Cuántos proyectos se ven de entrada; el resto aparece con "Ver más"
// (en 4 columnas: destacado 2×2 + 4 = dos filas completas; "Ver más" completa la tercera)
const VISIBLE = 5;
const hiddenCount = Math.max(0, items.length - VISIBLE);
---

<section class="work" id="trabajos">
  <div class="ambient" style="--gx: 85%; --gy: 10%" aria-hidden="true"></div>
  <div class="wrap">
    <SectionHead
      index="01"
      title="Trabajos"
      on="Una selección de proyectos, producciones y procesos."
      off="Del detrás de escena al resultado final."
    />

    <ol class="grid" data-grid>
      {
        items.map((p, i) => (
          <li class:list={['item reveal', { featured: i === 0, extra: i >= VISIBLE }]} style={`--d: ${(i % 3) * 0.08}s`}>
            <button class="card" data-open={p.slug} aria-label={`Ver fotos de ${p.client}`}>
              <span class="media">
                <Image
                  class="photo"
                  src={p.photos[0]}
                  alt=""
                  widths={i === 0 ? [640, 1080, 1440] : [480, 800]}
                  sizes={i === 0 ? '(min-width: 900px) 62vw, 100vw' : '(min-width: 900px) 31vw, 100vw'}
                  loading={i < 3 ? 'eager' : 'lazy'}
                />
                {p.photos[1] && (
                  <Image class="photo photo--alt" src={p.photos[1]} alt="" widths={[480, 800]} sizes="(min-width: 900px) 31vw, 100vw" loading="lazy" />
                )}
                <span class="chip">{p.services}</span>
                <span class="count">{p.photos.length} fotos</span>
              </span>
              <span class="info">
                <span class="num">({p.num})</span>
                <span class="client">{p.client}</span>
                <span class="meta">
                  {p.category} · {p.year}
                </span>
                <span class="go">
                  <Icon name="arrow-up-right" />
                </span>
              </span>
            </button>
          </li>
        ))
      }
    </ol>

    {
      hiddenCount > 0 && (
        <div class="more">
          <button class="more-btn" data-more aria-expanded="false">
            <span>Ver más</span>
            <span class="more-count">(+{hiddenCount})</span>
            <Icon name="arrow-down" />
          </button>
        </div>
      )
    }
  </div>

  {
    items.map((p) => (
      <dialog class="gallery" id={`g-${p.slug}`} aria-label={`Fotos de ${p.client}`}>
        <header class="g-head wrap">
          <div>
            <span class="num">({p.num})</span>
            <h3>{p.client}</h3>
            <p>
              {p.category} · {p.services} · {p.year}
            </p>
          </div>
          <form method="dialog">
            <button class="g-close">
              Cerrar <Icon name="close" />
            </button>
          </form>
        </header>
        <div class="g-track" data-lenis-prevent tabindex="0" role="region" aria-label={`Fotos de ${p.client}, desplazables`}>
          {p.photos.map((photo, i) => (
            <Image
              src={photo}
              alt={`${p.client} — foto ${i + 1}`}
              widths={[640, 1080, 1600]}
              sizes="(min-width: 900px) 50vw, 90vw"
              loading="lazy"
            />
          ))}
        </div>
        <p class="g-hint wrap">
          Deslizá para ver más <Icon name="arrow-right" />
        </p>
      </dialog>
    ))
  }
</section>

<style>
  .work {
    position: relative;
    isolation: isolate;
    padding-block: clamp(5rem, 10vw, 8rem);
    background: var(--ink);
    color: var(--white);
  }

  /* ---------- Grilla ---------- */
  .grid {
    display: grid;
    gap: clamp(1rem, 2vw, 1.5rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  /* Los extra se muestran recién al tocar "Ver más" */
  .grid:not(.is-open) .extra {
    display: none;
  }
  @media (min-width: 700px) {
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .featured {
      grid-column: span 2;
    }
    .featured .media {
      aspect-ratio: 16 / 10;
    }
  }
  @media (min-width: 1200px) {
    .grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
    /* El primero ocupa 2×2: composición asimétrica pero ordenada */
    .featured {
      grid-row: span 2;
    }
    .media {
      aspect-ratio: 1;
    }
    .featured .media {
      aspect-ratio: auto;
    }
  }

  .card {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    width: 100%;
    height: 100%;
    text-align: left;
  }
  .media {
    position: relative;
    display: block;
    flex: 1;
    min-height: 0;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border-radius: 1.1rem;
    background: var(--ink-2);
    transition: transform 0.16s var(--ease);
  }
  .media :global(.photo) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition:
      opacity 0.6s ease,
      transform 0.9s var(--ease);
  }
  /* Segunda foto: aparece al pasar el mouse (fundido, sin moverse con el cursor) */
  .media :global(.photo--alt) {
    opacity: 0;
  }

  /* Chips de vidrio sobre la foto */
  .chip,
  .count {
    position: absolute;
    z-index: 1;
    padding: 0.45em 0.9em;
    border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.18);
    background: rgba(13, 13, 13, 0.28);
    backdrop-filter: blur(12px) saturate(1.2);
    -webkit-backdrop-filter: blur(12px) saturate(1.2);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    color: var(--white);
  }
  .chip {
    left: 0.9rem;
    bottom: 0.9rem;
  }
  .count {
    top: 0.9rem;
    right: 0.9rem;
    opacity: 0;
    transform: translateY(-4px);
    transition:
      opacity 0.3s ease,
      transform 0.4s var(--ease);
  }

  .info {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: baseline;
    gap: 0.15rem 0.75rem;
    padding-inline: 0.15rem;
  }
  .num {
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--olive);
    font-variant-numeric: tabular-nums;
  }
  .client {
    font-family: var(--font-display);
    font-weight: 800;
    text-transform: uppercase;
    font-size: clamp(1.1rem, 1.6vw, 1.35rem);
    line-height: 1.05;
  }
  .featured .client {
    font-size: clamp(1.3rem, 2.4vw, 2rem);
  }
  .meta {
    grid-column: 2;
    font-size: 0.85rem;
    color: rgba(255, 255, 255, 0.5);
  }
  .go {
    grid-column: 3;
    grid-row: 1;
    font-size: 1.15rem;
    color: rgba(255, 255, 255, 0.6);
    transition:
      transform 0.35s var(--ease),
      color 0.2s ease;
  }

  .card:active .media {
    transform: scale(0.99);
  }
  @media (hover: hover) and (pointer: fine) {
    .card:hover :global(.photo) {
      transform: scale(1.04);
    }
    .card:hover :global(.photo--alt) {
      opacity: 1;
    }
    .card:hover .count {
      opacity: 1;
      transform: none;
    }
    .card:hover .go {
      color: var(--olive);
      transform: rotate(45deg);
    }
  }

  /* ---------- Ver más ---------- */
  .more {
    display: flex;
    justify-content: center;
    margin-top: clamp(2.5rem, 5vw, 3.5rem);
  }
  .more-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.6em;
    min-height: 3rem;
    padding: 0 1.6rem;
    border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.2);
    background: rgba(255, 255, 255, 0.05);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    transition:
      background-color 0.2s ease,
      color 0.2s ease,
      border-color 0.2s ease,
      transform 0.16s var(--ease);
  }
  .more-count {
    color: var(--olive);
    transition: color 0.2s ease;
  }
  .more-btn :global(svg) {
    transition: transform 0.35s var(--ease);
  }
  .more-btn[aria-expanded='true'] :global(svg) {
    transform: rotate(180deg);
  }
  .more-btn[aria-expanded='true'] .more-count {
    display: none;
  }
  .more-btn:active {
    transform: var(--press);
  }
  @media (hover: hover) and (pointer: fine) {
    .more-btn:hover {
      background: var(--olive);
      border-color: var(--olive);
      color: var(--ink);
    }
    .more-btn:hover .more-count {
      color: var(--ink);
    }
  }

  /* ---------- Galería ---------- */
  .gallery {
    width: 100vw;
    max-width: none;
    height: 100dvh;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    flex-direction: column;
    overscroll-behavior: contain;
    background: var(--ink);
    color: var(--white);
    /* Salida más corta que la entrada; allow-discrete deja animar el cierre antes de ocultarse */
    opacity: 0;
    translate: 0 12px;
    transition:
      opacity 0.2s ease,
      translate 0.2s var(--ease),
      display 0.2s allow-discrete,
      overlay 0.2s allow-discrete;
  }
  .gallery[open] {
    display: flex;
    opacity: 1;
    translate: 0 0;
    transition-duration: 0.35s;
  }
  @starting-style {
    .gallery[open] {
      opacity: 0;
      translate: 0 12px;
    }
  }
  .gallery::backdrop {
    background: var(--ink);
    opacity: 0;
    transition:
      opacity 0.2s ease,
      display 0.2s allow-discrete,
      overlay 0.2s allow-discrete;
  }
  .gallery[open]::backdrop {
    opacity: 1;
    transition-duration: 0.35s;
  }
  @starting-style {
    .gallery[open]::backdrop {
      opacity: 0;
    }
  }
  .g-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1rem;
    padding-block: 1.5rem;
  }
  .g-head h3 {
    font-family: var(--font-display);
    font-weight: 800;
    text-transform: uppercase;
    font-size: clamp(1.6rem, 4vw, 3rem);
    line-height: 1;
    margin-top: 0.3rem;
  }
  .g-head p {
    color: rgba(255, 255, 255, 0.6);
    font-size: 0.9rem;
    margin-top: 0.5rem;
  }
  .g-close {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    flex-shrink: 0;
    min-height: 2.75rem;
    padding: 0.7em 1.2em;
    border: 1px solid var(--line-dark);
    border-radius: 999px;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    transition:
      background-color 0.2s ease,
      color 0.2s ease,
      transform 0.16s var(--ease);
  }
  .g-close:active {
    transform: var(--press);
  }
  @media (hover: hover) and (pointer: fine) {
    .g-close:hover {
      background: var(--white);
      color: var(--ink);
    }
  }
  .g-track {
    flex: 1;
    min-height: 0;
    display: flex;
    gap: 1rem;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    padding: 0 var(--gutter);
    scrollbar-width: thin;
    scrollbar-color: var(--olive) transparent;
  }
  .g-track:focus-visible {
    outline-offset: -2px;
  }
  .g-track :global(img) {
    height: 100%;
    width: auto;
    max-width: 88vw;
    object-fit: contain;
    border-radius: 0.6rem;
    scroll-snap-align: center;
    flex-shrink: 0;
  }
  .g-hint {
    display: flex;
    align-items: center;
    gap: 0.5em;
    padding-block: 1rem 1.5rem;
    font-size: 0.75rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.55);
  }
  @media (prefers-reduced-motion: reduce) {
    .gallery,
    .gallery[open] {
      translate: none;
    }
    @starting-style {
      .gallery[open] {
        translate: none;
      }
    }
    .media :global(.photo),
    .count,
    .go {
      transition: opacity 0.2s ease;
    }
  }
</style>

<script>
  // "Ver más": muestra el resto de los proyectos con la misma entrada escalonada
  const grid = document.querySelector<HTMLOListElement>('[data-grid]')!;
  const moreBtn = document.querySelector<HTMLButtonElement>('[data-more]');
  moreBtn?.addEventListener('click', () => {
    const open = !grid.classList.contains('is-open');
    grid.classList.toggle('is-open', open);
    moreBtn.setAttribute('aria-expanded', String(open));
    moreBtn.querySelector('span')!.textContent = open ? 'Ver menos' : 'Ver más';
    if (open) {
      grid.querySelectorAll('.extra').forEach((el) => requestAnimationFrame(() => el.classList.add('is-in')));
    } else {
      grid.scrollIntoView({ behavior: 'smooth', block: 'end' });
    }
  });

  // Galería por proyecto
  document.querySelectorAll<HTMLButtonElement>('[data-open]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const dialog = document.getElementById(`g-${btn.dataset.open}`) as HTMLDialogElement;
      dialog.showModal();
      document.dispatchEvent(new Event('lenis:stop'));
      dialog.addEventListener('close', () => document.dispatchEvent(new Event('lenis:start')), { once: true });
    });
  });

  // Rueda del mouse vertical → scroll horizontal en la galería
  document.querySelectorAll<HTMLDivElement>('.g-track').forEach((track) => {
    track.addEventListener(
      'wheel',
      (e) => {
        if (Math.abs(e.deltaY) > Math.abs(e.deltaX)) {
          track.scrollLeft += e.deltaY;
          e.preventDefault();
        }
      },
      { passive: false },
    );
  });
</script>

---
import { contact } from '../data/site';
---

<section class="hero" id="top">
  <div class="copy">
    <p class="kicker reveal">Tomás Fidalgo / Portfolio + servicios</p>
    <h1 class="display headline" data-reveal>
      <span class="line-mask"><span>Contenido.</span></span>
      <span class="line-mask"><span style="--d: 0.08s">Foto. Video.</span></span>
      <span class="line-mask olive"><span style="--d: 0.16s">Estrategia.</span></span>
    </h1>
    <div class="actions reveal" style="--d: 0.35s">
      <a class="btn" href="#trabajos">Ver trabajos <span class="arrow">↓</span></a>
      <a class="btn btn--ghost" href={contact.whatsappUrl()} target="_blank" rel="noopener">Contame tu proyecto</a>
    </div>
  </div>

  <aside class="panel">
    <span class="year">2026</span>
    <div class="phone reveal" style="--d: 0.2s">
      <video
        src="/media/hero.mp4"
        poster="/media/hero.webp"
        autoplay
        muted
        loop
        playsinline
        preload="metadata"
        aria-label="Fragmentos de reels producidos por Fidalgo Studio"></video>
    </div>
    <div class="about reveal" style="--d: 0.45s">
      <strong>Fidalgo Studio</strong>
      <p>Estudio creativo enfocado en contenido, producción audiovisual y comunicación visual.</p>
      <a href={contact.instagramUrl} target="_blank" rel="noopener">{contact.instagram}</a>
    </div>
  </aside>
</section>

<style>
  .hero {
    display: grid;
    grid-template-columns: 1fr;
    min-height: 100svh;
    background: var(--white) url('/brand/textura.webp') center / cover;
  }
  .copy {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: 1.5rem;
    padding: 7rem var(--gutter) 3rem;
  }
  .headline {
    font-size: clamp(2.7rem, 11.5vw, 9.2rem);
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
    margin-top: 1rem;
  }

  .panel {
    position: relative;
    background: var(--olive);
    display: grid;
    justify-items: center;
    align-content: center;
    gap: 2rem;
    padding: 3rem var(--gutter);
  }
  .year {
    position: absolute;
    top: 1.6rem;
    right: var(--gutter);
    font-family: var(--font-display);
    font-size: 1.1rem;
  }
  .phone {
    width: min(68vw, 300px);
    aspect-ratio: 9 / 16;
    border-radius: 1.4rem;
    overflow: hidden;
    background: var(--ink);
    box-shadow: 0 30px 60px -20px rgba(13, 13, 13, 0.55);
  }
  .phone video {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .about {
    max-width: 30ch;
    font-size: 0.98rem;
    line-height: 1.5;
  }
  .about a {
    display: inline-block;
    margin-top: 0.8rem;
    border-bottom: 1px solid currentColor;
  }

  @media (min-width: 960px) {
    .hero {
      grid-template-columns: 1fr minmax(340px, 30vw);
    }
    .copy {
      padding-bottom: clamp(3rem, 8vh, 6rem);
    }
    .headline {
      font-size: clamp(3rem, 7.6vw, 9.2rem);
    }
    .panel {
      padding-top: 6rem;
      align-content: center;
    }
    .year {
      top: 5.6rem;
    }
    .phone {
      width: min(19vw, 300px);
    }
    /* El texto "Fidalgo Studio" se superpone al borde del panel, como en el PDF */
    .about {
      justify-self: start;
    }
  }
</style>

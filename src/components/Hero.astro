---
import { contact } from '../data/site';
import Icon from './Icon.astro';
---

<!--
  Hero: fondo oscuro con grano y luz ambiental oliva.
  El logo funciona como ventana: las letras están rellenas con video.
  Alrededor, un encuadre de visor de cámara.
-->
<section class="hero" id="top">
  <div class="glow" aria-hidden="true"></div>

  <div class="frame">
    <!-- Encuadre de visor: esquinas, REC y contador de tiempo -->
    <div class="viewfinder" aria-hidden="true">
      <span class="corner tl"></span><span class="corner tr"></span>
      <span class="corner bl"></span><span class="corner br"></span>
      <span class="rec"><i></i>REC</span>
      <span class="timecode" data-timecode>00:00:00:00</span>
    </div>

    <h1 class="title">
      <span class="sr-only">Fidalgo Studio: contenido, foto, video y estrategia</span>
      <span class="wordmark" aria-hidden="true">
        <!-- Base apenas visible por si el video tarda en cargar -->
        <span class="ghost"></span>
        <span class="fill">
          <video
            data-src="/media/showreel.mp4"
            poster="/media/showreel.webp"
            autoplay
            muted
            loop
            playsinline
            preload="none"
            data-hero-video></video>
        </span>
      </span>
    </h1>

    <p class="lede">
      <span class="on">Contenido, foto, video y estrategia</span>{' '}
      <span class="off">para marcas que tienen algo para decir.</span>
    </p>
  </div>

  <div class="foot wrap">
    <span class="tag">(00) Estudio creativo</span>
    <a class="scroll" href="#trabajos" aria-label="Ver trabajos">
      Ver trabajos <Icon name="arrow-down" />
    </a>
    <a class="tag ig" href={contact.instagramUrl} target="_blank" rel="noopener">{contact.instagram} — 2026</a>
  </div>

</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    display: grid;
    grid-template-rows: 1fr auto;
    min-height: 100svh;
    overflow: hidden;
    background: var(--ink);
    color: var(--white);
  }

  /* Luz ambiental oliva detrás del logo */
  .glow {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      radial-gradient(48% 38% at 50% 46%, rgba(150, 153, 110, 0.26), transparent 70%),
      radial-gradient(30% 24% at 72% 62%, rgba(150, 153, 110, 0.12), transparent 70%);
    filter: blur(20px);
  }

  .frame {
    position: relative;
    display: grid;
    align-content: center;
    justify-items: center;
    gap: clamp(1.5rem, 3vw, 2.5rem);
    margin: 5.5rem var(--gutter) 0;
    padding: clamp(2.5rem, 6vw, 5rem) clamp(1rem, 4vw, 4rem);
  }

  /* ---------- Visor ---------- */
  .viewfinder {
    position: absolute;
    inset: 0;
    pointer-events: none;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    color: rgba(255, 255, 255, 0.55);
    font-variant-numeric: tabular-nums;
  }
  .corner {
    position: absolute;
    width: clamp(1.4rem, 3vw, 2.4rem);
    aspect-ratio: 1;
    border: 0 solid rgba(255, 255, 255, 0.4);
  }
  .tl {
    top: 0;
    left: 0;
    border-width: 1px 0 0 1px;
  }
  .tr {
    top: 0;
    right: 0;
    border-width: 1px 1px 0 0;
  }
  .bl {
    bottom: 0;
    left: 0;
    border-width: 0 0 1px 1px;
  }
  .br {
    bottom: 0;
    right: 0;
    border-width: 0 1px 1px 0;
  }
  .rec,
  .timecode {
    position: absolute;
    top: 1rem;
  }
  .rec {
    left: clamp(2rem, 4vw, 3.2rem);
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
  }
  .rec i {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--olive);
    box-shadow: 0 0 10px var(--olive);
    animation: blink 1.6s steps(2, jump-none) infinite;
    transition:
      background-color 0.2s ease,
      box-shadow 0.2s ease;
  }
  /* Al pasar el mouse por el logo, la cámara "graba de verdad": el punto se pone rojo */
  @media (hover: hover) and (pointer: fine) {
    .hero:has(.wordmark:hover) .rec i {
      background: #e5332a;
      box-shadow: 0 0 12px #e5332a;
    }
  }
  @keyframes blink {
    50% {
      opacity: 0.15;
    }
  }
  .timecode {
    right: clamp(2rem, 4vw, 3.2rem);
  }

  /* ---------- Logo relleno de video ---------- */
  .title {
    width: min(100%, 1180px);
    margin: 0;
  }
  .wordmark {
    position: relative;
    display: block;
    aspect-ratio: 3000 / 1143;
  }
  .ghost,
  .fill {
    position: absolute;
    inset: 0;
    -webkit-mask: url('/brand/logo.svg') center / contain no-repeat;
    mask: url('/brand/logo.svg') center / contain no-repeat;
  }
  /* Base gris clara: el video se suma con "screen", así las zonas oscuras del video no apagan la letra */
  .ghost {
    background: rgba(255, 255, 255, 0.24);
  }
  .fill {
    mix-blend-mode: screen;
  }
  .fill video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* Un poco más de luz para que las letras se lean sobre el negro */
    filter: brightness(1.35) contrast(1.05) saturate(0.85);
  }

  /* Frase: algunas palabras en blanco, el resto en gris (selective emphasis) */
  .lede {
    max-width: 34ch;
    text-align: center;
    font-size: clamp(1.1rem, 1.8vw, 1.45rem);
    line-height: 1.35;
    letter-spacing: -0.01em;
  }
  .on {
    color: var(--white);
  }
  .off {
    color: rgba(255, 255, 255, 0.42);
  }

  /* ---------- Pie del hero ---------- */
  .foot {
    position: relative;
    z-index: 4;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 1rem;
    padding-block: 1.5rem 1.75rem;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .tag {
    color: rgba(255, 255, 255, 0.55);
  }
  .ig {
    justify-self: end;
    text-transform: none;
    letter-spacing: 0.04em;
    transition: color 0.2s ease;
  }
  .scroll {
    display: inline-flex;
    align-items: center;
    gap: 0.6em;
    min-height: 2.75rem;
    padding: 0 1.2rem;
    border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.18);
    background: rgba(255, 255, 255, 0.06);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    transition:
      background-color 0.2s ease,
      color 0.2s ease,
      transform 0.16s var(--ease);
  }
  .scroll :global(svg) {
    animation: nudge 1.8s var(--ease-in-out) infinite;
  }
  @keyframes nudge {
    50% {
      transform: translateY(3px);
    }
  }
  .scroll:active {
    transform: var(--press);
  }
  @media (hover: hover) and (pointer: fine) {
    .scroll:hover {
      background: var(--olive);
      border-color: var(--olive);
      color: var(--ink);
    }
    .ig:hover {
      color: var(--white);
    }
  }

  /* ---------- Entrada ---------- */
  :global(.js) .hero .wordmark {
    opacity: 0;
    filter: blur(18px);
    transform: scale(0.97);
    transition:
      opacity 1.2s var(--ease),
      filter 1.4s var(--ease),
      transform 1.4s var(--ease);
  }
  :global(.js) .hero .lede,
  :global(.js) .hero .viewfinder,
  :global(.js) .hero .foot {
    opacity: 0;
    transition: opacity 1s ease 0.6s;
  }
  :global(.js) .hero.is-in .wordmark {
    opacity: 1;
    filter: none;
    transform: none;
  }
  :global(.js) .hero.is-in .lede,
  :global(.js) .hero.is-in .viewfinder,
  :global(.js) .hero.is-in .foot {
    opacity: 1;
  }

  /* ---------- Celular ---------- */
  @media (max-width: 699px) {
    .frame {
      margin: 5.25rem 0.75rem 0;
      padding-inline: 0;
    }
    .title {
      width: 94%;
    }
    .foot {
      grid-template-columns: 1fr auto;
    }
    .foot .tag:first-child {
      display: none;
    }
    .rec,
    .timecode {
      top: 0.7rem;
      font-size: 0.62rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .rec i,
    .scroll :global(svg) {
      animation: none;
    }
    :global(.js) .hero .wordmark {
      filter: none;
      transform: none;
      transition: opacity 0.4s ease;
    }
  }
</style>

<script>
  const hero = document.querySelector<HTMLElement>('.hero')!;
  const video = hero.querySelector<HTMLVideoElement>('[data-hero-video]')!;
  const timecode = hero.querySelector<HTMLElement>('[data-timecode]')!;
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // Entrada: el logo aparece desenfocado y se enfoca
  requestAnimationFrame(() => hero.classList.add('is-in'));

  // El video pesa: se pide recién cuando terminó de cargar el resto de la página.
  // Mientras tanto se ve el póster, que es su primer cuadro. Con menos movimiento queda solo el póster.
  // El autoplay nativo arranca solo cuando la pestaña está visible (aunque se haya abierto en segundo plano)
  let inView: boolean | undefined;
  const loadVideo = () => {
    if (inView === false) video.autoplay = false;
    video.src = video.dataset.src!;
  };
  if (!reduceMotion) {
    if (document.readyState === 'complete') loadVideo();
    else window.addEventListener('load', loadVideo, { once: true });
  }

  // Contador tipo cámara (hh:mm:ss:frames) que corre desde que se abrió la página
  const pad = (n: number) => String(Math.floor(n)).padStart(2, '0');
  const start = performance.now();
  let raf = 0;
  const tick = () => {
    const t = (performance.now() - start) / 1000;
    timecode.textContent = `${pad(t / 3600)}:${pad((t / 60) % 60)}:${pad(t % 60)}:${pad((t % 1) * 25)}`;
    raf = requestAnimationFrame(tick);
  };

  // Video y contador solo corren mientras el hero está en pantalla
  new IntersectionObserver(([entry]) => {
    inView = entry.isIntersecting;
    if (entry.isIntersecting) {
      if (video.src) video.play().catch(() => {});
      raf = requestAnimationFrame(tick);
    } else {
      video.pause();
      cancelAnimationFrame(raf);
    }
  }).observe(hero);
</script>

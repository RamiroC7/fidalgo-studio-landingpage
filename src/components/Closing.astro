---
import { contact, clients } from '../data/site';
import Icon from './Icon.astro';
const year = new Date().getFullYear();

// Créditos finales, como al terminar una película
const credits = [
  { role: 'Producción', names: ['Fidalgo Studio'] },
  { role: 'Contenido · Foto · Video · Edición', names: ['Tomás Fidalgo'] },
  { role: 'Con', names: clients },
  { role: 'En colaboración con', names: ['Diseño + identidad', 'Publicidad digital', 'Web + software'] },
];
---

<section class="closing" id="contacto">
  <div class="ambient" style="--gx: 50%; --gy: 30%" aria-hidden="true"></div>

  <div class="wrap">
    <div class="directed reveal">
      <p class="by">Dirigido por</p>
      <h2 class="name">
        <span class="fade-text">Tomás Fidalgo</span>
      </h2>
    </div>

    <p class="stat reveal">
      <span class="stat-num" data-count={clients.length}>{clients.length}</span>
      <span class="stat-label">marcas confiaron en el estudio</span>
    </p>

    <dl class="credits">
      {
        credits.map((c, i) => (
          <div class="credit reveal" style={`--d: ${i * 0.08}s`}>
            <dt>{c.role}</dt>
            <dd>{c.names.join(' · ')}</dd>
          </div>
        ))
      }
    </dl>

    <div class="cta reveal">
      <p>
        <span class="em-on">¿Tenés un proyecto?</span>{' '}
        <span class="em-off">Contame qué querés hacer y vemos qué tiene sentido construir.</span>
      </p>
      <a class="btn" href={contact.whatsappUrl()} target="_blank" rel="noopener">
        Contame tu proyecto <Icon name="arrow-right" class="arrow" />
      </a>
    </div>

    <!-- Contacto chico, al pie -->
    <footer class="foot">
      <ul class="channels">
        <li>
          <a href={contact.whatsappUrl()} target="_blank" rel="noopener">WhatsApp {contact.whatsappDisplay}</a>
        </li>
        <li><a href={`mailto:${contact.email}`}>{contact.email}</a></li>
        <li>
          <a href={contact.instagramUrl} target="_blank" rel="noopener">{contact.instagram}</a>
        </li>
      </ul>
      <div class="legal">
        <img src="/brand/logo-white.png" alt="Fidalgo Studio" width="1000" height="381" loading="lazy" />
        <span>© {year} Fidalgo Studio</span>
        <span>
          Desarrollado por <a class="kei" href="https://keisoftware.dev" target="_blank" rel="noopener">KEI Software</a>
        </span>
      </div>
    </footer>
  </div>
</section>

<style>
  .closing {
    position: relative;
    isolation: isolate;
    /* Abajo deja lugar para el botón flotante de WhatsApp */
    padding-block: clamp(6rem, 12vw, 10rem) 6rem;
    text-align: center;
  }

  .directed {
    display: grid;
    justify-items: center;
    gap: 0.6rem;
  }
  .by {
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.5);
  }
  .name {
    position: relative;
    display: inline-block;
    font-family: var(--font-display);
    font-weight: 800;
    text-transform: uppercase;
    font-size: clamp(2.4rem, 9vw, 8.5rem);
    line-height: 0.95;
  }

  .stat {
    display: grid;
    justify-items: center;
    gap: 0.4rem;
    margin-top: clamp(3rem, 6vw, 4.5rem);
  }
  .stat-num {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(3rem, 8vw, 5.5rem);
    line-height: 1;
    color: var(--olive);
    font-variant-numeric: tabular-nums;
  }
  .stat-label {
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.6);
  }

  /* Créditos: rol en gris, nombres en blanco, centrados como en el cierre de una película */
  .credits {
    display: grid;
    gap: 1.6rem;
    max-width: 46rem;
    margin: clamp(3rem, 6vw, 4.5rem) auto 0;
  }
  .credit {
    display: grid;
    gap: 0.35rem;
  }
  dt {
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--olive);
  }
  dd {
    margin: 0;
    font-size: clamp(0.98rem, 1.4vw, 1.15rem);
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.85);
  }

  .cta {
    display: grid;
    justify-items: center;
    gap: 1.5rem;
    margin-top: clamp(4rem, 8vw, 6rem);
  }
  .cta p {
    max-width: 34ch;
    font-size: clamp(1.1rem, 1.8vw, 1.4rem);
    line-height: 1.4;
  }

  /* ---------- Pie ---------- */
  .foot {
    margin-top: clamp(5rem, 10vw, 8rem);
    padding-top: 1.5rem;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
  }
  .channels {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.25rem 2rem;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 0.88rem;
  }
  .channels a {
    position: relative;
    display: inline-block;
    padding-block: 0.5rem;
    color: rgba(255, 255, 255, 0.7);
    transition: color 0.2s ease;
  }
  /* Rayita que se dibuja desde la izquierda al entrar y se va hacia la derecha al salir */
  .channels a::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0.3rem;
    height: 1px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 0.35s var(--ease);
  }
  .legal {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem 2rem;
    margin-top: 1.5rem;
    font-size: 0.75rem;
    color: rgba(255, 255, 255, 0.45);
  }
  .legal img {
    height: 1.6rem;
    width: auto;
    opacity: 0.8;
  }
  .kei {
    font-weight: 700;
    color: #5b9cf6;
    transition: color 0.2s ease;
  }
  @media (hover: hover) and (pointer: fine) {
    .channels a:hover {
      color: var(--olive);
    }
    .channels a:hover::after {
      transform: scaleX(1);
      transform-origin: left;
    }
    .kei:hover {
      color: var(--white);
    }
  }
  @media (max-width: 599px) {
    .legal {
      justify-content: center;
    }
  }
</style>

<script>
  // El número sube de 0 al total cuando entra en pantalla (rápido al principio, frena al final)
  const num = document.querySelector<HTMLElement>('[data-count]')!;
  const total = Number(num.dataset.count);
  if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
    num.textContent = '0';
    const io = new IntersectionObserver(
      ([entry]) => {
        if (!entry.isIntersecting) return;
        io.disconnect();
        const start = performance.now();
        const duration = 1400;
        const tick = (now: number) => {
          const t = Math.min((now - start) / duration, 1);
          num.textContent = String(Math.round(total * (1 - Math.pow(1 - t, 3))));
          if (t < 1) requestAnimationFrame(tick);
        };
        requestAnimationFrame(tick);
      },
      { rootMargin: '0px 0px -15% 0px' },
    );
    io.observe(num);
  }
</script>

---
import { contact, clients } from '../data/site';
import Icon from './Icon.astro';
const year = new Date().getFullYear();

// Créditos finales, como al terminar una película
const credits = [
  { role: 'Producción', names: ['Fidalgo Studio'] },
  { role: 'Contenido · Foto · Video · Edición', names: ['Tomás Fidalgo'] },
  { role: 'Con', names: clients },
  { role: 'En colaboración con', names: ['Diseño + identidad', 'Publicidad digital', 'Web + software'] },
];
---

<section class="closing" id="contacto">
  <div class="ambient" style="--gx: 50%; --gy: 30%" aria-hidden="true"></div>

  <div class="wrap">
    <div class="directed reveal">
      <p class="by">Dirigido por</p>
      <h2 class="name">
        <span class="fade-text">Tomás Fidalgo</span>
        <span class="tail t1" aria-hidden="true"></span>
        <span class="tail t2" aria-hidden="true"></span>
      </h2>
    </div>

    <dl class="credits">
      {
        credits.map((c, i) => (
          <div class="credit reveal" style={`--d: ${i * 0.08}s`}>
            <dt>{c.role}</dt>
            <dd>{c.names.join(' · ')}</dd>
          </div>
        ))
      }
    </dl>

    <div class="cta reveal">
      <p>
        <span class="em-on">¿Tenés un proyecto?</span>{' '}
        <span class="em-off">Contame qué querés hacer y vemos qué tiene sentido construir.</span>
      </p>
      <a class="btn" href={contact.whatsappUrl()} target="_blank" rel="noopener">
        Contame tu proyecto <Icon name="arrow-right" class="arrow" />
      </a>
    </div>

    <!-- Contacto chico, al pie -->
    <footer class="foot">
      <ul class="channels">
        <li>
          <a href={contact.whatsappUrl()} target="_blank" rel="noopener">WhatsApp {contact.whatsappDisplay}</a>
        </li>
        <li><a href={`mailto:${contact.email}`}>{contact.email}</a></li>
        <li>
          <a href={contact.instagramUrl} target="_blank" rel="noopener">{contact.instagram}</a>
        </li>
      </ul>
      <div class="legal">
        <img src="/brand/logo-white.png" alt="Fidalgo Studio" width="1000" height="381" loading="lazy" />
        <span>© {year} Fidalgo Studio</span>
        <span>
          Desarrollado por <a class="kei" href="https://keisoftware.dev" target="_blank" rel="noopener">KEI Software</a>
        </span>
      </div>
    </footer>
  </div>
</section>

<style>
  .closing {
    position: relative;
    isolation: isolate;
    /* Abajo deja lugar para el botón flotante de WhatsApp */
    padding-block: clamp(6rem, 12vw, 10rem) 6rem;
    text-align: center;
  }

  .directed {
    display: grid;
    justify-items: center;
    gap: 0.6rem;
  }
  .by {
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.5);
  }
  .name {
    position: relative;
    display: inline-block;
    font-family: var(--font-display);
    font-weight: 800;
    text-transform: uppercase;
    font-size: clamp(2.4rem, 9vw, 8.5rem);
    line-height: 0.95;
  }
  .tail {
    position: absolute;
    inset: -10% -3% -10% 0;
    pointer-events: none;
  }
  .t1 {
    backdrop-filter: blur(2px);
    -webkit-backdrop-filter: blur(2px);
    mask: linear-gradient(90deg, transparent 66%, #000 82%);
    -webkit-mask: linear-gradient(90deg, transparent 66%, #000 82%);
  }
  .t2 {
    backdrop-filter: blur(7px);
    -webkit-backdrop-filter: blur(7px);
    mask: linear-gradient(90deg, transparent 84%, #000 98%);
    -webkit-mask: linear-gradient(90deg, transparent 84%, #000 98%);
  }

  /* Créditos: rol en gris, nombres en blanco, centrados como en el cierre de una película */
  .credits {
    display: grid;
    gap: 1.6rem;
    max-width: 46rem;
    margin: clamp(3.5rem, 7vw, 5.5rem) auto 0;
  }
  .credit {
    display: grid;
    gap: 0.35rem;
  }
  dt {
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--olive);
  }
  dd {
    margin: 0;
    font-size: clamp(0.98rem, 1.4vw, 1.15rem);
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.85);
  }

  .cta {
    display: grid;
    justify-items: center;
    gap: 1.5rem;
    margin-top: clamp(4rem, 8vw, 6rem);
  }
  .cta p {
    max-width: 34ch;
    font-size: clamp(1.1rem, 1.8vw, 1.4rem);
    line-height: 1.4;
  }

  /* ---------- Pie ---------- */
  .foot {
    margin-top: clamp(5rem, 10vw, 8rem);
    padding-top: 1.5rem;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
  }
  .channels {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.25rem 2rem;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 0.88rem;
  }
  .channels a {
    display: inline-block;
    padding-block: 0.5rem;
    color: rgba(255, 255, 255, 0.7);
    transition: color 0.2s ease;
  }
  .legal {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem 2rem;
    margin-top: 1.5rem;
    font-size: 0.75rem;
    color: rgba(255, 255, 255, 0.45);
  }
  .legal img {
    height: 1.6rem;
    width: auto;
    opacity: 0.8;
  }
  .kei {
    font-weight: 700;
    color: #5b9cf6;
    transition: color 0.2s ease;
  }
  @media (hover: hover) and (pointer: fine) {
    .channels a:hover {
      color: var(--olive);
    }
    .kei:hover {
      color: var(--white);
    }
  }
  @media (max-width: 599px) {
    .legal {
      justify-content: center;
    }
  }
</style>

---
import { nav, contact } from '../data/site';
import Icon from './Icon.astro';
---

<!-- Navbar con los links escritos (sin menú desplegable). Arriba de todo es transparente;
     al scrollear toma un fondo de vidrio oscuro. El link de la sección visible queda resaltado. -->
<header class="header">
  <div class="bar wrap">
    <a href="#top" class="logo" aria-label="Fidalgo Studio, volver arriba">
      <img src="/brand/logo-white.png" alt="" width="1000" height="381" />
    </a>

    <nav class="links" aria-label="Secciones">
      {
        nav.map((item, i) => (
          <a href={item.href} data-nav={item.href.slice(1)}>
            <span class="n">{String(i + 1).padStart(2, '0')}</span>
            {item.label}
          </a>
        ))
      }
    </nav>

    <a class="cta" href={contact.whatsappUrl()} target="_blank" rel="noopener">
      <span class="cta-long">Contame tu proyecto</span>
      <span class="cta-short">Escribime</span>
      <Icon name="arrow-up-right" />
    </a>
  </div>
</header>

<style>
  .header {
    position: fixed;
    inset: 0 0 auto;
    z-index: 50;
    overflow-x: clip;
    color: var(--white);
    transition:
      background-color 0.3s ease,
      border-color 0.3s ease,
      translate 0.45s var(--ease);
    border-bottom: 1px solid transparent;
  }
  .header.scrolled {
    background: rgba(13, 13, 13, 0.55);
    border-bottom-color: rgba(255, 255, 255, 0.08);
    backdrop-filter: blur(18px) saturate(1.3);
    -webkit-backdrop-filter: blur(18px) saturate(1.3);
  }
  .header.hide {
    translate: 0 -100%;
  }
  .header.hide:focus-within {
    translate: 0 0;
  }

  /* Logo | links | CTA */
  .bar {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 1rem 2rem;
    min-height: 4.5rem;
  }
  .logo img {
    height: 1.9rem;
    width: auto;
  }

  .links {
    display: flex;
    justify-content: center;
    gap: 0.25rem;
  }
  .links a {
    position: relative;
    display: inline-flex;
    align-items: baseline;
    gap: 0.4em;
    min-height: 2.75rem;
    align-items: center;
    padding: 0 0.9rem;
    border-radius: 999px;
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    white-space: nowrap;
    color: rgba(255, 255, 255, 0.55);
    transition:
      color 0.25s ease,
      background-color 0.25s ease;
  }
  .n {
    font-size: 0.62rem;
    font-weight: 700;
    color: var(--olive);
    font-variant-numeric: tabular-nums;
  }
  /* Sección visible: link en blanco con fondo de vidrio */
  .links a.active {
    color: var(--white);
    background: rgba(255, 255, 255, 0.08);
  }
  @media (hover: hover) and (pointer: fine) {
    .links a:hover {
      color: var(--white);
    }
  }

  .cta {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    min-height: 2.75rem;
    padding: 0 1.2rem;
    border-radius: 999px;
    background: var(--olive);
    color: var(--ink);
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    white-space: nowrap;
    transition:
      background-color 0.2s ease,
      transform 0.16s var(--ease);
  }
  .cta:active {
    transform: var(--press);
  }
  .cta-short {
    display: none;
  }
  @media (hover: hover) and (pointer: fine) {
    .cta:hover {
      background: var(--olive-light);
    }
  }

  /* Tablet y celular: logo + CTA arriba; los links abajo, en una fila que se desliza de costado */
  @media (max-width: 999px) {
    .bar {
      grid-template-columns: minmax(0, 1fr) auto;
      row-gap: 0;
      padding-top: 0.6rem;
    }
    .links {
      grid-column: 1 / -1;
      grid-row: 2;
      justify-content: flex-start;
      min-width: 0;
      padding: 0.25rem 0 0.5rem;
      overflow-x: auto;
      scrollbar-width: none;
      /* Se desvanece a la derecha para indicar que hay más links */
      mask: linear-gradient(90deg, #000 calc(100% - 2.5rem), transparent);
      -webkit-mask: linear-gradient(90deg, #000 calc(100% - 2.5rem), transparent);
    }
    .links::-webkit-scrollbar {
      display: none;
    }
    .links a {
      padding: 0 0.8rem;
      font-size: 0.72rem;
    }
    .links a:first-child {
      padding-left: 0;
    }
    .links a.active:first-child {
      padding-left: 0.8rem;
    }
  }
  @media (max-width: 479px) {
    .cta-long {
      display: none;
    }
    .cta-short {
      display: inline;
    }
    .logo img {
      height: 1.6rem;
    }
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>('.header')!;
  const links = [...header.querySelectorAll<HTMLAnchorElement>('[data-nav]')];

  // Fondo de vidrio al scrollear; se esconde al bajar y reaparece al subir
  let lastY = window.scrollY;
  const onScroll = () => {
    const y = window.scrollY;
    header.classList.toggle('scrolled', y > 40);
    if (Math.abs(y - lastY) > 6) {
      header.classList.toggle('hide', y > 500 && y > lastY);
      lastY = y;
    }
  };
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();

  // Resalta el link de la sección que ocupa el centro de la pantalla
  const setActive = (id: string | null) => {
    links.forEach((a) => a.classList.toggle('active', a.dataset.nav === id));
    // En celular, centra el link activo dentro de la fila deslizable (sin mover la página)
    const active = links.find((a) => a.dataset.nav === id);
    const row = active?.parentElement;
    if (active && row && row.scrollWidth > row.clientWidth) {
      row.scrollTo({ left: active.offsetLeft - (row.clientWidth - active.offsetWidth) / 2, behavior: 'smooth' });
    }
  };
  const io = new IntersectionObserver(
    (entries) => {
      for (const e of entries) if (e.isIntersecting) setActive(e.target.id);
    },
    { rootMargin: '-45% 0px -50% 0px' },
  );
  links.forEach((a) => {
    const section = document.getElementById(a.dataset.nav!);
    if (section) io.observe(section);
  });
  // Arriba de todo (hero) no hay ninguno activo
  const hero = document.getElementById('top');
  if (hero) {
    new IntersectionObserver(([e]) => e.isIntersecting && setActive(null), { rootMargin: '-45% 0px -50% 0px' }).observe(hero);
  }
</script>

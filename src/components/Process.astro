---
import { steps } from '../data/site';

// Iconos de línea más firmes, con un detalle cada uno (viewBox 60×60)
const icons = [
  // Contame: burbuja con tres puntos (escribiendo)
  `<path d="M8 12 H52 Q58 12 58 18 V40 Q58 46 52 46 H26 L14 56 V46 H8 Q2 46 2 40 V18 Q2 12 8 12 Z"/><circle cx="18" cy="29" r="2.6"/><circle cx="30" cy="29" r="2.6"/><circle cx="42" cy="29" r="2.6"/>`,
  // Analizamos: lupa con barras de datos adentro
  `<circle cx="25" cy="25" r="18"/><path d="M38 38 L56 56"/><path d="M17 33 V26 M25 33 V19 M33 33 V23"/>`,
  // Definimos: compás de precisión
  `<path d="M30 4 V16"/><circle cx="30" cy="16" r="3"/><path d="M28 18 L14 56"/><path d="M32 18 L46 56"/><path d="M21 40 H39"/>`,
  // Coordinamos: bandera ondeando con check
  `<path d="M10 56 V4"/><path d="M10 6 Q24 0 36 8 T56 8 V38 Q42 32 30 40 T10 38 Z"/><path d="M22 22 L29 29 L42 16"/>`,
];
const drawable = (svg: string) => svg.replace(/<(path|rect|circle)\b/g, '<$1 pathLength="1"');
---

<section class="section theme-olive process" id="proceso">
  <div class="wrap">
    <h2 class="display title" data-reveal>
      <span class="line-mask"><span>¿No sabés qué</span></span>
      <span class="line-mask"><span style="--d: 0.08s">hacer con tu marca?</span></span>
    </h2>
    <p class="lead reveal">Contame qué querés mejorar o lograr. Lo demás lo armamos juntos.</p>

    <ol class="route" data-route>
      <span class="track" aria-hidden="true"><span class="fill"></span></span>
      {
        steps.map((s, i) => (
          <li class="stop reveal" style={`--d: ${i * 0.12}s`}>
            <span class="dot">
              <svg viewBox="0 0 60 60" aria-hidden="true" set:html={drawable(icons[i])} />
            </span>
            <span class="num">{String(i + 1).padStart(2, '0')}</span>
            <h3>{s.title}</h3>
            <p>{s.text}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .title {
    margin-bottom: 1.75rem;
  }
  .lead {
    max-width: 36ch;
    font-family: var(--font-apple);
    font-weight: 500;
    font-size: clamp(1.2rem, 1.9vw, 1.55rem);
    line-height: 1.25;
    letter-spacing: -0.022em;
  }

  /* Recorrido: en celular una columna con la línea a la izquierda; en escritorio, una fila */
  .route {
    position: relative;
    display: grid;
    gap: 2.25rem;
    margin: clamp(3rem, 7vw, 5rem) 0 0;
    padding: 0;
    list-style: none;
  }
  .track {
    position: absolute;
    top: 2rem;
    bottom: 2rem;
    left: 2rem;
    width: 2px;
    background: rgba(13, 13, 13, 0.22);
    overflow: hidden;
  }
  .fill {
    display: block;
    width: 100%;
    height: 100%;
    background: var(--ink);
    transform-origin: top;
  }
  :global(.js) .fill {
    transform: scaleY(0);
    transition: transform 1.6s var(--ease-in-out) 0.2s;
  }
  :global(.js) .route.is-in .fill {
    transform: scaleY(1);
  }

  .stop {
    position: relative;
    display: grid;
    grid-template-columns: 4rem 1fr;
    align-items: start;
    gap: 0.35rem 1.25rem;
  }
  /* Círculo en verde profundo: acento de color que sigue la paleta de la sección */
  .dot {
    position: relative;
    z-index: 1;
    display: grid;
    place-items: center;
    width: 4rem;
    height: 4rem;
    border-radius: 50%;
    grid-row: span 2;
    background: var(--olive-deep);
    color: #d6d9b4;
    transition:
      transform 0.4s var(--ease),
      background-color 0.3s ease;
  }
  .dot svg {
    width: 2.2rem;
    height: 2.2rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 3;
    stroke-linecap: round;
    stroke-linejoin: round;
    overflow: visible;
    transition: transform 0.5s var(--ease);
  }
  .dot svg * {
    vector-effect: non-scaling-stroke;
  }
  :global(.js) .dot path,
  :global(.js) .dot circle {
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    transition: stroke-dashoffset 1s var(--ease-in-out);
    transition-delay: calc(0.5s + var(--d, 0s));
  }
  :global(.js) .stop.is-in .dot path,
  :global(.js) .stop.is-in .dot circle {
    stroke-dashoffset: 0;
  }

  .num {
    display: none;
  }
  h3 {
    grid-column: 2;
    grid-row: 1;
    align-self: end;
    font-family: var(--font-display);
    font-weight: 800;
    text-transform: uppercase;
    font-size: clamp(1.4rem, 2.6vw, 2rem);
    line-height: 1;
    padding-top: 0.5rem;
    transition: transform 0.4s var(--ease);
  }
  .stop p {
    grid-column: 2;
    grid-row: 2;
    align-self: start;
    max-width: 30ch;
    font-size: 0.95rem;
    line-height: 1.45;
    color: rgba(13, 13, 13, 0.82);
  }

  /* Microinteracciones (solo con mouse): el círculo gira, el icono se levanta y el título se corre */
  @media (hover: hover) and (pointer: fine) {
    .stop:hover .dot {
      transform: scale(1.08) rotate(-6deg);
      background: var(--ink);
      color: var(--olive);
    }
    .stop:hover .dot svg {
      transform: translateY(-2px);
    }
    .stop:hover h3 {
      transform: translateX(4px);
    }
  }
  .stop:active .dot {
    transform: var(--press);
  }

  @media (min-width: 900px) {
    .route {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 0 1.5rem;
      padding-top: 2rem;
    }
    .track {
      top: 4rem;
      bottom: auto;
      left: 0;
      right: 0;
      width: auto;
      height: 2px;
    }
    .fill {
      transform-origin: left;
    }
    :global(.js) .fill {
      transform: scaleX(0);
    }
    :global(.js) .route.is-in .fill {
      transform: scaleX(1);
    }
    .stop {
      grid-template-columns: 1fr;
      grid-template-rows: auto auto;
      gap: 0.5rem;
    }
    .stop h3,
    .stop p {
      grid-column: auto;
    }
    .stop h3 {
      grid-row: auto;
      padding-top: 0;
    }
    .stop p {
      grid-row: auto;
    }
    .dot {
      grid-row: auto;
    }
    .num {
      display: block;
      order: -1;
      font-size: 0.75rem;
      font-weight: 700;
      letter-spacing: 0.1em;
      color: var(--ink);
      font-variant-numeric: tabular-nums;
      margin-top: 1.25rem;
    }
    .dot {
      order: -2;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(.js) .fill,
    :global(.js) .dot path,
    :global(.js) .dot circle {
      transform: none;
      stroke-dashoffset: 0;
      transition: none;
    }
    .dot,
    .dot svg,
    .stop h3 {
      transition: none;
    }
  }
</style>

<script>
  // Al entrar en pantalla, la línea y los iconos se trazan (mismo criterio que el resto del sitio)
  const route = document.querySelector('[data-route]');
  if (route) {
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (e.isIntersecting) {
            route.classList.add('is-in');
            route.querySelectorAll('.stop').forEach((s) => s.classList.add('is-in'));
            io.disconnect();
          }
        }
      },
      { rootMargin: '0px 0px -10% 0px' },
    );
    io.observe(route);
  }
</script>

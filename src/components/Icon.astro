---
// Íconos de trazo único (1.5px, extremos redondeados) para flechas, play y cerrar.
interface Props {
  name: 'arrow-right' | 'arrow-left' | 'arrow-down' | 'arrow-up-right' | 'play' | 'close';
  class?: string;
}
const { name, class: className } = Astro.props;
---

<svg
  class:list={['icon', className]}
  viewBox="0 0 24 24"
  width="1em"
  height="1em"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {name === 'arrow-right' && <path d="M4 12h16M14 6l6 6-6 6" />}
  {name === 'arrow-left' && <path d="M20 12H4M10 6l-6 6 6 6" />}
  {name === 'arrow-down' && <path d="M12 4v16M6 14l6 6 6-6" />}
  {name === 'arrow-up-right' && <path d="M7 17 17 7M8 7h9v9" />}
  {name === 'play' && <path d="M8 5.5v13a.5.5 0 0 0 .77.42l10.2-6.5a.5.5 0 0 0 0-.84L8.77 5.08A.5.5 0 0 0 8 5.5Z" fill="currentColor" />}
  {name === 'close' && <path d="M6 6l12 12M18 6 6 18" />}
</svg>

<style>
  .icon {
    display: inline-block;
    flex-shrink: 0;
    vertical-align: -0.125em;
  }
</style>

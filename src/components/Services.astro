---
import { services, contact } from '../data/site';
import SectionHead from './SectionHead.astro';
import Icon from './Icon.astro';

const direct = services.map((s, i) => ({ ...s, n: i + 1 })).filter((s) => !s.collab);
const collab = services.map((s, i) => ({ ...s, n: i + 1 })).filter((s) => s.collab);
const pad = (n: number) => String(n).padStart(2, '0');
---

<section class="services" id="servicios">
  <div class="ambient" style="--gx: 20%; --gy: 20%" aria-hidden="true"></div>

  <div class="wrap">
    <SectionHead index="04" title="Servicios" on="Contenido. Foto. Video. Estrategia." off="Soluciones creativas pensadas según lo que realmente necesita cada proyecto." />

    <!-- Servicio directo: lista editorial -->
    <p class="group-label reveal">Servicio directo</p>
    <ol class="list">
      {
        direct.map((s) => (
          <li class="row reveal">
            <span class="n">({pad(s.n)})</span>
            <h3>{s.title}</h3>
            <p class="text">{s.text}</p>
            <ul class="tags">
              {s.tags.map((t) => (
                <li>{t}</li>
              ))}
            </ul>
          </li>
        ))
      }
    </ol>

    <!-- En colaboración: encuadre técnico + franja de luz -->
    <div class="collab reveal">
      <span class="streak" aria-hidden="true"></span>
      <span class="corner tl" aria-hidden="true"></span><span class="corner tr" aria-hidden="true"></span>
      <span class="corner bl" aria-hidden="true"></span><span class="corner br" aria-hidden="true"></span>

      <div class="collab-head">
        <p class="group-label">En colaboración con especialistas</p>
        <h3 class="collab-title">
          <span class="em-on">Más áreas.</span>
          <span class="em-off">Un mismo punto de contacto.</span>
        </h3>
        <img class="mark" src="/brand/isotipo-white.png" alt="" width="205" height="240" />
      </div>

      <ul class="collab-cards">
        {
          collab.map((s) => (
            <li class="ccard glass">
              <span class="n">({pad(s.n)})</span>
              <h4>{s.title}</h4>
              <p>{s.text}</p>
              <p class="ctags">{s.tags.join(' · ')}</p>
            </li>
          ))
        }
      </ul>

      <div class="collab-foot">
        <p class="em-off">
          Todos los proyectos se coordinan a través de Fidalgo Studio. Armamos el equipo según lo que realmente necesite tu
          proyecto.
        </p>
        <a class="pill" href={contact.whatsappUrl('Hola Tomás! Quiero consultar por un proyecto integral.')} target="_blank" rel="noopener">
          Consultar <Icon name="arrow-right" />
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .services {
    position: relative;
    isolation: isolate;
    /* La franja de luz se extiende más allá de los bordes: se recorta para no ensanchar la página */
    overflow-x: clip;
    padding-block: clamp(5rem, 10vw, 8rem);
  }
  .group-label {
    margin-bottom: 1rem;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--olive);
  }

  /* ---------- Lista editorial ---------- */
  .list {
    margin: 0 0 clamp(4rem, 8vw, 6rem);
    padding: 0;
    list-style: none;
  }
  .row {
    position: relative;
    display: grid;
    gap: 0.6rem 2rem;
    padding: clamp(1.5rem, 2.5vw, 2rem) 0;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
  }
  .row:last-child {
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }
  /* Franja de luz oliva que aparece detrás de la fila al pasar */
  .row::before {
    content: '';
    position: absolute;
    inset: 15% -2%;
    z-index: -1;
    background: radial-gradient(50% 50% at 30% 50%, rgba(150, 153, 110, 0.28), transparent 70%);
    filter: blur(24px);
    opacity: 0;
    transition: opacity 0.5s ease;
  }
  .n {
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--olive);
    font-variant-numeric: tabular-nums;
  }
  .row h3 {
    font-family: var(--font-display);
    font-weight: 800;
    text-transform: uppercase;
    font-size: clamp(1.5rem, 3vw, 2.6rem);
    line-height: 1;
    color: rgba(255, 255, 255, 0.85);
    transition:
      color 0.3s ease,
      transform 0.5s var(--ease);
  }
  .text {
    max-width: 44ch;
    font-size: 0.98rem;
    line-height: 1.5;
    color: rgba(255, 255, 255, 0.6);
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .tags li {
    padding: 0.35em 0.85em;
    border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.12);
    background: rgba(255, 255, 255, 0.04);
    font-size: 0.75rem;
    color: rgba(255, 255, 255, 0.7);
  }
  @media (min-width: 1000px) {
    .row {
      grid-template-columns: 4rem minmax(0, 1.2fr) minmax(0, 1fr);
      align-items: start;
    }
    .tags {
      grid-column: 3;
    }
  }
  @media (hover: hover) and (pointer: fine) {
    .row:hover::before {
      opacity: 1;
    }
    .row:hover h3 {
      color: var(--white);
      transform: translateX(0.5rem);
    }
  }

  /* ---------- En colaboración: encuadre técnico ---------- */
  .collab {
    position: relative;
    isolation: isolate;
    padding: clamp(2rem, 5vw, 4rem);
  }
  .corner {
    position: absolute;
    width: clamp(1.5rem, 3vw, 2.5rem);
    aspect-ratio: 1;
    border: 0 solid var(--olive);
  }
  .tl {
    top: 0;
    left: 0;
    border-width: 1.5px 0 0 1.5px;
    border-top-left-radius: 0.6rem;
  }
  .tr {
    top: 0;
    right: 0;
    border-width: 1.5px 1.5px 0 0;
    border-top-right-radius: 0.6rem;
  }
  .bl {
    bottom: 0;
    left: 0;
    border-width: 0 0 1.5px 1.5px;
    border-bottom-left-radius: 0.6rem;
  }
  .br {
    bottom: 0;
    right: 0;
    border-width: 0 1.5px 1.5px 0;
    border-bottom-right-radius: 0.6rem;
  }
  /* Franja de luz horizontal con blur direccional */
  .streak {
    position: absolute;
    left: -10%;
    right: -10%;
    top: 38%;
    z-index: -1;
    height: 26%;
    background:
      linear-gradient(90deg, transparent, rgba(150, 153, 110, 0.55) 20%, rgba(150, 153, 110, 0.15) 50%, rgba(150, 153, 110, 0.55) 80%, transparent);
    filter: blur(40px);
    opacity: 0.8;
  }

  .collab-head {
    position: relative;
    margin-bottom: clamp(2rem, 4vw, 3rem);
  }
  .collab-title {
    display: grid;
    font-family: var(--font-display);
    font-weight: 800;
    text-transform: uppercase;
    font-size: clamp(1.8rem, 4.5vw, 3.8rem);
    line-height: 0.98;
  }
  /* Micro-branding: el isotipo como firma, no como protagonista */
  .mark {
    position: absolute;
    top: 0;
    right: 0;
    width: auto;
    height: 2.2rem;
    opacity: 0.8;
  }

  .collab-cards {
    display: grid;
    gap: 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  @media (min-width: 900px) {
    .collab-cards {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  .ccard {
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
    padding: 1.6rem;
    border-radius: 1.4rem;
    transition:
      border-color 0.3s ease,
      transform 0.5s var(--ease);
  }
  .ccard h4 {
    font-family: var(--font-display);
    font-weight: 800;
    text-transform: uppercase;
    font-size: clamp(1.25rem, 1.8vw, 1.6rem);
    line-height: 1.02;
  }
  .ccard p {
    font-size: 0.92rem;
    line-height: 1.5;
    color: rgba(255, 255, 255, 0.7);
  }
  .ccard .ctags {
    margin-top: auto;
    padding-top: 0.6rem;
    font-size: 0.78rem;
    color: var(--olive);
  }
  @media (hover: hover) and (pointer: fine) {
    .ccard:hover {
      border-color: rgba(150, 153, 110, 0.6);
      transform: translateY(-4px);
    }
  }

  .collab-foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem 2rem;
    margin-top: clamp(2rem, 4vw, 2.75rem);
  }
  .collab-foot p {
    max-width: 52ch;
    font-size: 0.92rem;
  }
  @media (prefers-reduced-motion: reduce) {
    .row h3,
    .ccard {
      transition: none;
    }
  }
</style>

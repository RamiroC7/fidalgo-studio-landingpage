---
import { services } from '../data/site';

// Iconos de línea con el mismo trazo que el hero y "Sobre mí" (viewBox 60×60 aprox.)
const icons = [
  // Creación de contenido: lamparita (ideas)
  `<path d="M30 8 C15 8 8 20 8 32 C8 45 18 51 20 62 H40 C42 51 52 45 52 32 C52 20 45 8 30 8 Z"/><path d="M21 70 H39 M22 78 H38"/>`,
  // Fotografía + video: cámara de cine
  `<rect x="4" y="16" width="36" height="26" rx="3"/><path d="M40 22 L54 16 V36 L40 30 Z"/><path d="M14 42 L8 56 M14 42 L24 56 M14 42 V56"/>`,
  // Edición audiovisual: claqueta
  `<rect x="4" y="22" width="52" height="34" rx="2"/><path d="M4 30 H56"/><path d="M4 22 L10 12 H56 L50 22"/>`,
  // Estrategia de contenido: calendario con planificación
  `<rect x="6" y="12" width="48" height="44" rx="4"/><path d="M6 24 H54 M18 6 V16 M42 6 V16"/><path d="M16 36 H24 M30 36 H38 M16 46 H24"/>`,
  // Gestión de redes: burbuja de chat con micrófono (conversación)
  `<path d="M8 10 H52 Q56 10 56 14 V40 Q56 44 52 44 H28 L16 54 V44 H8 Q4 44 4 40 V14 Q4 10 8 10 Z"/><path d="M22 22 H38 M22 30 H32"/>`,
];
const drawable = (svg: string) => svg.replace(/<(path|rect|circle)\b/g, '<$1 pathLength="1"');
// Variante de color por tarjeta: la marca alterna oliva, negro, papel y blanco
// Fila 1: oliva + negro. Fila 2: papel, negro y oliva. Ningún negro queda pegado a otro.
const tones = ['olive', 'ink', 'paper', 'ink', 'olive'];
---

<section class="section services" id="servicios">
  <div class="wrap">
    <div class="section-head">
      <div>
        <h2 class="display" data-reveal>
          <span class="line-mask"><span>Qué</span></span>
          <span class="line-mask"><span style="--d: 0.08s">hago.</span></span>
        </h2>
      </div>
      <p class="reveal">Servicios desarrollados desde Fidalgo Studio para marcas, proyectos y emprendimientos.</p>
    </div>

    <ul class="bento">
      {
        services.map((s, i) => (
          <li class:list={['card', `card--${tones[i]}`, `card--${i + 1}`, 'reveal']} style={`--d: ${i * 0.08}s`}>
            <span class="ico" aria-hidden="true">
              <svg viewBox="0 0 60 84" set:html={drawable(icons[i])} />
            </span>
            <h3>{s.title}</h3>
            <p>{s.text}</p>
            <ul class="chips">
              {s.tags.split(' · ').map((t) => (
                <li>{t}</li>
              ))}
            </ul>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  /* Bento: 6 columnas en escritorio. Tarjetas de distinto tamaño y color de marca. */
  .bento {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
    padding: 0;
    margin: 0;
    list-style: none;
  }
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    min-height: 15rem;
    padding: clamp(1.4rem, 2.6vw, 2rem);
    border-radius: 1.25rem;
    overflow: hidden;
    transition:
      transform 0.2s var(--ease),
      background-color 0.3s ease,
      color 0.3s ease;
  }
  .card:active {
    transform: var(--press);
  }
  .card--olive {
    background: var(--olive);
    color: var(--ink);
  }
  .card--ink {
    background: var(--ink);
    color: var(--white);
  }
  .card--paper {
    background: var(--paper);
    color: var(--ink);
  }
  .card--white {
    background: var(--white);
    color: var(--ink);
    box-shadow: inset 0 0 0 1px var(--line-light);
  }

  /* Icono en una forma redondeada: se dibuja al entrar en pantalla */
  .ico {
    display: grid;
    place-items: center;
    width: 4.2rem;
    height: 4.2rem;
    border-radius: 50%;
    background: rgba(13, 13, 13, 0.12);
    margin-bottom: auto;
  }
  .card--ink .ico {
    background: rgba(150, 153, 110, 0.2);
  }
  .ico svg {
    width: 2.2rem;
    height: auto;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
    overflow: visible;
    transition: transform 0.5s var(--ease);
  }
  :global(.js) .ico path,
  :global(.js) .ico rect {
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    transition: stroke-dashoffset 1.2s var(--ease-in-out);
    transition-delay: calc(0.3s + var(--d, 0s));
  }
  :global(.js) .card.is-in .ico path,
  :global(.js) .card.is-in .ico rect {
    stroke-dashoffset: 0;
  }

  h3 {
    font-family: var(--font-display);
    font-weight: 800;
    text-transform: uppercase;
    font-size: clamp(1.3rem, 2vw, 1.8rem);
    line-height: 1.02;
    max-width: 16ch;
  }
  p {
    font-size: 0.95rem;
    line-height: 1.5;
    max-width: 38ch;
    opacity: 0.85;
  }
  /* Etiquetas como chips chiquitos, en vez de una línea de texto gris */
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin: auto 0 0;
    padding: 0;
    list-style: none;
  }
  .chips li {
    padding: 0.3em 0.75em;
    border-radius: 999px;
    border: 1px solid currentColor;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    opacity: 0.8;
  }

  @media (hover: hover) and (pointer: fine) {
    .card:hover .ico svg {
      transform: translateY(-3px) rotate(-4deg);
    }
    .card--olive:hover {
      background: var(--olive-light);
    }
    .card--paper:hover {
      background: var(--white);
    }
    .card--white:hover {
      box-shadow: inset 0 0 0 1px var(--ink);
    }
  }

  @media (min-width: 700px) {
    .bento {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 1000px) {
    .bento {
      grid-template-columns: repeat(6, minmax(0, 1fr));
    }
    /* Fila 1: dos tarjetas grandes. Fila 2: tres medianas. */
    .card--1,
    .card--2 {
      grid-column: span 3;
      min-height: 22rem;
    }
    .card--3,
    .card--4,
    .card--5 {
      grid-column: span 2;
    }
    .card--1 {
      grid-row: span 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(.js) .ico path,
    :global(.js) .ico rect {
      stroke-dashoffset: 0;
      transition: none;
    }
    .card,
    .ico svg {
      transition: none;
    }
  }
</style>

---
// Encabezado de sección: (0X) + título grande con fade (blanco → gris),
// más una frase opcional con énfasis selectivo.
interface Props {
  index: string;
  title: string;
  on?: string;
  off?: string;
}
const { index, title, on, off } = Astro.props;
---

<header class="head">
  <div>
    <span class="index reveal">({index})</span>
    <h2 class="h-section title" data-reveal>
      <span class="line-mask"><span class="fade-text">{title}</span></span>
    </h2>
  </div>
  {
    (on || off) && (
      <p class="intro reveal" style="--d: 0.15s">
        {on && <span class="em-on">{on}</span>} {off && <span class="em-off">{off}</span>}
      </p>
    )
  }
</header>

<style>
  .head {
    display: grid;
    gap: 1.5rem 4rem;
    align-items: end;
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
  }
  .title {
    position: relative;
    display: inline-block;
  }
  .intro {
    max-width: 32ch;
    font-size: clamp(1.05rem, 1.6vw, 1.3rem);
    line-height: 1.4;
  }
  @media (min-width: 900px) {
    .head {
      grid-template-columns: 1fr auto;
    }
    .intro {
      text-align: right;
    }
  }
</style>

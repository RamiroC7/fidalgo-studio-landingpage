---
import { skills } from '../data/site';
// Alternancia de color: oliva, negro, oliva, negro. Cada columna es una pieza sola.
const tones = ['olive', 'ink', 'olive', 'ink'];
---

<section class="section theme-paper skills">
  <div class="wrap">
    <div class="section-head">
      <div>
        <h2 class="display display--md" data-reveal>
          <span class="line-mask"><span>Habilidades</span></span>
          <span class="line-mask"><span style="--d: 0.08s">que combinan.</span></span>
        </h2>
      </div>
    </div>

    <ol class="cols">
      {
        skills.map((s, i) => (
          <li class:list={['col', `col--${tones[i]}`, 'reveal']} style={`--d: ${i * 0.1}s`}>
            <span class="big" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <h3>{s.title}</h3>
            <p>{s.text}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .cols {
    display: grid;
    gap: 1rem;
    padding: 0;
    margin: 0;
    list-style: none;
  }
  .col {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    min-height: 22rem;
    padding: clamp(1.5rem, 3vw, 2.2rem);
    border-radius: 2rem;
    overflow: hidden;
    transition:
      transform 0.3s var(--ease),
      background-color 0.3s ease;
  }
  .col--olive {
    background: var(--olive);
    color: var(--ink);
  }
  .col--ink {
    background: var(--ink);
    color: var(--white);
  }
  /* Número gigante en contorno: es la pieza gráfica de la tarjeta */
  .big {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(4.5rem, 9vw, 7.5rem);
    line-height: 0.85;
    color: transparent;
    -webkit-text-stroke: 1.5px var(--ink);
    letter-spacing: -0.02em;
    margin-bottom: auto;
    transition: color 0.4s var(--ease);
  }
  .col--ink .big {
    -webkit-text-stroke-color: var(--olive);
  }
  h3 {
    /* Tres líneas reservadas: los títulos quedan alineados aunque tengan distinta longitud */
    min-height: 3.1em;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(1.3rem, 2vw, 1.7rem);
    line-height: 1.02;
    text-transform: uppercase;
    display: flex;
    align-items: flex-end;
  }
  p {
    font-size: 0.95rem;
    line-height: 1.5;
    opacity: 0.85;
    max-width: 34ch;
  }
  .col:active {
    transform: var(--press);
  }
  @media (hover: hover) and (pointer: fine) {
    /* Al pasar el mouse el número se rellena con el color contrario */
    .col--olive:hover .big {
      color: var(--ink);
    }
    .col--ink:hover .big {
      color: var(--olive);
    }
    .col--olive:hover {
      background: var(--olive-light);
    }
    .col--ink:hover {
      background: var(--ink-2);
    }
  }
  @media (min-width: 900px) {
    .cols {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
    .col {
      min-height: 30rem;
      border-radius: 2.5rem;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .col,
    .big {
      transition: none;
    }
  }
</style>

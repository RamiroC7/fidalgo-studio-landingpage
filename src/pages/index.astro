---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Work from '../components/Work.astro';
import Reels from '../components/Reels.astro';
import Studio from '../components/Studio.astro';
import Services from '../components/Services.astro';
import Closing from '../components/Closing.astro';
import WhatsAppFab from '../components/WhatsAppFab.astro';
---

<Base>
  <Header />
  <main id="contenido" tabindex="-1">
    <Hero />
    <Work />
    <Reels />
    <Studio />
    <Services />
    <Closing />
  </main>
  <WhatsAppFab />
</Base>

<script>
  // Los videos marcados con data-autoplay se reproducen solo cuando están en pantalla.
  // Con "reducir movimiento" no se reproduce nada solo: queda el póster.
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const videos = document.querySelectorAll<HTMLVideoElement>('video[data-autoplay]');

  if (reduceMotion) {
    videos.forEach((v) => {
      v.removeAttribute('autoplay');
      v.pause();
    });
  } else {
    const io = new IntersectionObserver(
      (entries) => {
        for (const { target, isIntersecting } of entries) {
          const v = target as HTMLVideoElement;
          if (isIntersecting) {
            if (v.preload === 'none') v.preload = 'auto';
            v.play().catch(() => {});
          } else {
            v.pause();
          }
        }
      },
      { threshold: 0.25 },
    );
    videos.forEach((v) => io.observe(v));
  }
</script>

<style>
  main:focus {
    outline: none;
  }
</style>
